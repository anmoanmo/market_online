# 404-Shop 本地演示配置模板
# 复制为 .env 后填写真实值；.env 已被 .gitignore 忽略，不要提交。

MYSQL_ROOT_PASSWORD=1234
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PWD=1234
JWT_SECRET=change-me-jwt-secret-local-demo-only

NACOS_ADDR=nacos:8848
REDIS_HOST=redis
RABBIT_HOST=rabbitmq
RABBIT_USER=admin
RABBIT_PASSWORD=admin

VITE_API_BASE_URL=http://localhost:8090
APP_UPLOAD_STORAGE=minio
PUBLIC_UPLOAD_BASE_URL=http://localhost:8090/uploads/avatar/

# 邮箱验证码，项目演示如需真实注册流程必须填写可用 SMTP。
MAIL_HOST=smtp.example.com
MAIL_USERNAME=change-me@example.com
MAIL_PASSWORD=change-me
MAIL_FROM=change-me@example.com

# 支付宝沙箱配置，真实演示必须填写，并将回调地址配置为内网穿透后的公网 URL。
ALIPAY_SERVER_URL=https://openapi-sandbox.dl.alipaydev.com/gateway.do
ALIPAY_APP_ID=change-me
ALIPAY_PRIVATE_KEY=change-me
ALIPAY_PUBLIC_KEY=change-me
ALIPAY_NOTIFY_URL=http://localhost:9003/api/callback/v1/alipay
ALIPAY_RETURN_URL=http://localhost:5173/user/orders

# 七牛对象存储，默认本地演示不需要填写；需要云存储时再写入自己的真实值。
QINIU_DOMAIN=
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=

# MinIO 本地对象存储。Compose 容器内访问使用 minio:9000，宿主机控制台见 README。
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=404-shop
MINIO_PUBLIC_ENDPOINT=http://localhost:9100
